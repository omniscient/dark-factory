# Dark Factory — instance configuration
#
# Copy this file to deploy/instance.env (gitignored) and fill in your values.
# Always start compose with --env-file so FACTORY_INSTANCE, PROJECT_DIR and IMAGE_TAG
# below also reach compose interpolation:
#
#   docker compose --env-file deploy/instance.env -f deploy/docker-compose.yml up -d
#
# This file configures the SCHEDULER. Dispatched run containers do not read it: they
# get their secrets from <PROJECT_DIR>/.archon/.env (see docs/onboarding-new-target.md).
#
# The identity block is printed ready-to-paste by:
#   scripts/bootstrap_target.sh OWNER/REPO
# Leaving identity vars blank or unset makes the image fall back to MarketHawk's
# values, which WILL NOT work for any other repo or board.

# ---------------------------------------------------------------------------
# Authentication (required — no defaults)
# ---------------------------------------------------------------------------

# GitHub token with repo + project + workflow scope (e.g. `gh auth token`).
GH_TOKEN=

# Claude authentication: CLAUDE_CODE_OAUTH_TOKEN (subscription; create one with
# `claude setup-token`) or ANTHROPIC_API_KEY (direct API billing).
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Compose / host wiring
# ---------------------------------------------------------------------------

# Scopes container names and the scheduler state volume; one value per target so
# several instances can share a host. Convention: the repo name.
FACTORY_INSTANCE=

# Absolute host path of your target repo checkout (mounted read-only at
# /workspace/project). The scheduler reads <PROJECT_DIR>/.archon/.env from it and,
# optionally, <PROJECT_DIR>/config/config.yaml. Runs always clone fresh from GitHub.
# Windows: use forward slashes, e.g. C:/git/my-repo
PROJECT_DIR=

# Optional: pin the factory image tag (default: latest).
# IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Instance identity (REQUIRED — paste the block from scripts/bootstrap_target.sh)
# ---------------------------------------------------------------------------

# GitHub owner and repo of the target (the repo whose issues the factory works).
FACTORY_OWNER=
FACTORY_REPO=

# Projects v2 board: node ID (PVT_…) and the number shown in the board URL.
FACTORY_PROJECT_ID=
FACTORY_PROJECT_NUMBER=

# Status field node ID (PVTSSF_…) and the option ID of each of the 7 columns.
FACTORY_STATUS_FIELD=
FACTORY_STATUS_READY=
FACTORY_STATUS_IN_PROGRESS=
FACTORY_STATUS_IN_REVIEW=
FACTORY_STATUS_BLOCKED=
FACTORY_STATUS_DONE=
FACTORY_STATUS_BACKLOG=
FACTORY_STATUS_REFINED=

# Human-readable product name used in issue comments and log markers.
FACTORY_PRODUCT_NAME=

# Path inside the run container where entrypoint.sh clones the target, and the
# prefix for run container names. Convention: /workspace/<repo>, <repo>-dark-factory-run-
FACTORY_CLONE_DIR=
FACTORY_RUN_PREFIX=

# Manual lookups, if you are not using the bootstrap script:
#   gh project view <NUMBER> --owner <OWNER> --format json --jq .id
#   gh project field-list <NUMBER> --owner <OWNER> --format json \
#     --jq '.fields[] | select(.name=="Status") | {id, options}'
# (MarketHawk's own values live in deploy/instances/markethawk/instance.env.)

# ---------------------------------------------------------------------------
# Scheduler tuning (optional — defaults are safe for most deployments)
# ---------------------------------------------------------------------------

# Max concurrent factory containers (default: 1).
FACTORY_WIP_LIMIT=1

# Seconds between board polls (default: 60).
POLL_INTERVAL=60

# ---------------------------------------------------------------------------
# Transparent model traffic proxy (optional — default off, see #208)
# ---------------------------------------------------------------------------

# Opt in to routing Claude Code traffic through factory-model-proxy for a
# per-request ledger (docs/dark-factory-model-proxy-rollout.md). Default
# unset/false = today's direct-to-Anthropic behavior, byte-for-byte.
# FACTORY_MODEL_PROXY_ENABLED=true

# Required alongside FACTORY_MODEL_PROXY_ENABLED — points Claude Code at the
# proxy instead of api.anthropic.com directly.
# ANTHROPIC_BASE_URL=http://factory-model-proxy:8787

# Opt-in raw request/response artifact capture (off by default — the compact
# ledger has no payload content; raw artifacts do, including system prompts
# and code diffs). Retention: RAW_ARTIFACT_RETENTION_DAYS (default 7).
# RAW_ARTIFACT_CAPTURE=true
# RAW_ARTIFACT_RETENTION_DAYS=7
