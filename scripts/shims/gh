#!/usr/bin/env bash
# side-effect guard (#196/R5): PATH-shadows `gh`. Same activation rule as scripts/shims/git.
set -euo pipefail

SHIM_DIR="$(cd "$(dirname "$0")" && pwd -P)"

_real_bin() {
  local name="$1" d
  IFS=':' read -ra _dirs <<< "$PATH"
  for d in "${_dirs[@]}"; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    # Physical-path comparison (F8): a relative, trailing-slash or symlinked PATH entry
    # for the shim dir must still be recognised as "us", or the shim would exec itself.
    [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$SHIM_DIR" ] && continue
    if [ -x "$d/$name" ]; then echo "$d/$name"; return 0; fi
  done
  return 1
}

REAL_GH=$(_real_bin gh) || { echo "side-effect guard: real gh not found on PATH" >&2; exit 1; }

if [ -z "${FACTORY_SIDE_EFFECT_LEVEL:-}" ] || [ "${CLAUDECODE:-}" != "1" ]; then
  exec "$REAL_GH" "$@"
fi

LEVEL="$FACTORY_SIDE_EFFECT_LEVEL"
# Resolved relative to this script's own location, not $CLONE_DIR — same rationale as
# scripts/shims/git (see its matching comment): CLONE_DIR is never inherited by a phase
# agent's own Bash-tool subprocess.
FACTORY_CORE_DIR="$(cd "$SHIM_DIR/.." && pwd)/factory_core"
CLI="$FACTORY_CORE_DIR/side_effect.py"
PROFILE_JSON=$(python3 "$CLI" render --level "$LEVEL" 2>/dev/null) || {
  echo "side-effect guard: cannot resolve profile for level ${LEVEL}" >&2
  exit 1
}
LEVEL_NAME=$(jq -r '.name' <<<"$PROFILE_JSON")
LEVEL_NUM=$(jq -r '.level' <<<"$PROFILE_JSON")
GH_MODE=$(jq -r '.gh_mode' <<<"$PROFILE_JSON")
mapfile -t GH_ALLOWED < <(jq -r '.gh_allowed[]' <<<"$PROFILE_JSON")
mapfile -t GH_DENIED  < <(jq -r '.gh_denied[]'  <<<"$PROFILE_JSON")

_emit_denied() {
  local verb="$1"
  local artdir="${ARTIFACTS_DIR:-}"
  [ -n "$artdir" ] || return 0
  local run issue
  run=$(basename "$artdir")
  issue=$(jq -r '.resolved_number // empty' "$artdir/issue.json" 2>/dev/null || true)
  [ -n "$issue" ] || issue=0
  python3 "$FACTORY_CORE_DIR/cli.py" run-record health-event \
    --run-id "$run" --issue "$issue" --event side_effect.denied \
    --detail tool=gh "verb=${verb}" "level=${LEVEL}" >/dev/null 2>&1 || true
}

deny() {
  # F13: the adapter guide's section until #201 creates docs/factory-target-boundary.md.
  echo "side-effect guard: '$1' is denied at level ${LEVEL} (${LEVEL_NAME}); see docs/adapter-authoring-guide.md#side-effect-levels" >&2
  _emit_denied "$1"
  exit 1
}

_in_list() {
  local needle="$1"; shift
  local x
  for x in "$@"; do [ "$x" = "$needle" ] && return 0; done
  return 1
}

# #553: a nested classify-only run (an alias expansion being judged, see _finish) must
# never exec anything -- it only reports deny (exit 1) or pass (exit 0).
_CLASSIFY_ONLY="${SIDE_EFFECT_SHIM_CLASSIFY_ONLY:-}"
# Only this shim sets it, always with a depth >= 1. At depth 0 it came from the caller's
# own environment: fail loudly rather than silently do nothing on every call.
if [ "$_CLASSIFY_ONLY" = "1" ] && [ "${SIDE_EFFECT_SHIM_DEPTH:-0}" = "0" ]; then
  deny "SIDE_EFFECT_SHIM_CLASSIFY_ONLY outside a nested check"
fi

_GH_ARGS=("$@")
VERB1="${_GH_ARGS[0]:-}"
# Version/help never mutate anything and gh accepts them at any level.
case "$VERB1" in --version|--help|-h|help|version)
  [ "$_CLASSIFY_ONLY" = "1" ] && exit 0
  exec "$REAL_GH" "$@" ;;
esac
# Operator review of PR #396 (#1): cobra accepts persistent flags between the command
# words (`gh pr -R o/r create` runs `pr create`), so the second word is read after
# skipping them -- otherwise `TWO_WORD="pr -R"` matched nothing and passed at level 4
# while the legitimate `gh issue -R o/r create` was wrongly denied at level 3.
_J=1
while [ "$_J" -lt "${#_GH_ARGS[@]}" ]; do
  case "${_GH_ARGS[$_J]}" in
    -R|--repo) _J=$((_J + 2)) ;;
    --repo=*|-*) _J=$((_J + 1)) ;;
    *) break ;;
  esac
done
VERB2="${_GH_ARGS[$_J]:-}"
TWO_WORD="$VERB1 $VERB2"

# #553 / spec Requirements 2 and 5: every path that would exec real gh comes here once
# the literal form has passed. gh may run something else under VERB1 (an alias, an
# installed extension), so the expanded form must pass the same classification too
# (tighten-only), at every level. Each check fails closed.
_finish() {
  local depth="${SIDE_EFFECT_SHIM_DEPTH:-0}" aliases line exp="" found=0 exts name toks=()
  case "$depth" in ''|*[!0-9]*) deny "${VERB1:-gh} (alias chain depth)" ;; esac
  if [ -n "$VERB1" ]; then
    # `gh -R o/r pr create`: a flag in VERB1's place hides the command from the tables.
    [[ "$VERB1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || deny "$VERB1 (flag before the command)"
    # gh refuses an alias over a core command, so only a non-core VERB1 can match here.
    aliases=$("$REAL_GH" alias list 2>/dev/null) || deny "$VERB1 (alias resolution failed)"
    while IFS= read -r line; do
      case "$line" in
        "$VERB1:") found=1; exp="" ;;
        "$VERB1: "*) found=1; exp="${line#"$VERB1: "}" ;;
      esac
    done <<<"$aliases"
    if [ "$found" = "1" ]; then
      [ "$depth" -lt 5 ] || deny "$VERB1 (alias chain too deep)"
      case "$exp" in
        ''|'|'*|'>'*) deny "$VERB1 (empty or multi-line alias)" ;;
        '!'*) deny "$VERB1 (shell alias)" ;;
        *[\"\'\\\$]*) deny "$VERB1 (alias value needs shell-style parsing)" ;;
      esac
      read -ra toks <<<"$exp"
      SIDE_EFFECT_SHIM_CLASSIFY_ONLY=1 SIDE_EFFECT_SHIM_DEPTH=$((depth + 1)) \
        "$SHIM_DIR/gh" "${toks[@]}" "${_GH_ARGS[@]:1}" || exit $?
    fi
  fi
  # Requirement 5, levels 1-4: an extension binary acts with gh's own credentials and no
  # verb-level check, so neither installing one nor running one is allowed below level 5.
  if [ "$LEVEL_NUM" -le 4 ]; then
    case "$VERB1" in
      extension|extensions|ext)
        case "$VERB2" in install|upgrade|exec) deny "extension $VERB2" ;; esac ;;
    esac
    if [ -n "$VERB1" ]; then
      # `gh extension list` only reads the local extensions directory but exits 4 when no
      # token is present at all; a placeholder for this one call keeps the check working
      # without a token (and with one, the real token is passed unchanged).
      exts=$(GH_TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-placeholder}}" "$REAL_GH" extension list 2>/dev/null) \
        || deny "$VERB1 (extension resolution failed)"
      while IFS=$'\t' read -r name _; do
        if [ "$name" = "gh $VERB1" ]; then deny "$VERB1 (extension)"; fi
      done <<<"$exts"
    fi
  fi
  [ "$_CLASSIFY_ONLY" = "1" ] && exit 0
  exec "$REAL_GH" "${_GH_ARGS[@]}"
}

if [ "$VERB1" = "api" ]; then
  METHOD=""; HAS_BODY=0; TAKE_NEXT=0
  for arg in "${@:2}"; do
    if [ "$TAKE_NEXT" = "1" ]; then METHOD="$arg"; TAKE_NEXT=0; continue; fi
    case "$arg" in
      -X|--method) TAKE_NEXT=1 ;;
      -X*) METHOD="${arg#-X}" ;;
      --method=*) METHOD="${arg#--method=}" ;;
      -f*|--field*|-F*|--raw-field*|--input*) HAS_BODY=1 ;;
    esac
  done
  # F3: gh's own rule -- "the default HTTP request method is GET normally and POST if any
  # parameters were added" -- so a body with no explicit method IS a POST and must be
  # judged as one by the deny-mode (level 4/5) checks below, not waved through as GET.
  if [ -z "$METHOD" ]; then
    if [ "$HAS_BODY" = "1" ]; then METHOD="POST"; else METHOD="GET"; fi
  fi
  METHOD=$(printf '%s' "$METHOD" | tr '[:lower:]' '[:upper:]')
  if [ "$GH_MODE" = "allow" ]; then
    if [ "$METHOD" != "GET" ] || [ "$HAS_BODY" = "1" ]; then
      deny "api ${METHOD}"
    fi
  else
    if [ "$METHOD" = "DELETE" ] && _in_list "api:DELETE" "${GH_DENIED[@]}"; then
      deny "api -X DELETE"
    fi
    if [ "$METHOD" != "GET" ] && _in_list "api:non-GET" "${GH_DENIED[@]}"; then
      deny "api ${METHOD}"
    fi
  fi
  _finish
fi

DISPLAY_VERB="$VERB1"
[ -n "$VERB2" ] && DISPLAY_VERB="$TWO_WORD"

if [ "$GH_MODE" = "allow" ]; then
  # Never-list first (R1: denied at every level, checked before any allow-list) -- this is
  # what keeps `gh secret list` / `gh auth status` out despite the VERB2-alone read match.
  if _in_list "$VERB1" "${GH_DENIED[@]}" || _in_list "$TWO_WORD" "${GH_DENIED[@]}"; then
    deny "$DISPLAY_VERB"
  fi
  # Three checks, not two: gh_allowed mixes single-word read verbs that must match in
  # EITHER position ("view"/"list"/"status"/"search" — e.g. `gh issue view`, `gh pr
  # list`, bare `gh status`) with exact two-word grants ("issue create" etc., which
  # must NOT become "anything ending in create" — `gh pr create` must stay denied).
  # VERB2-alone is safe to check unconditionally: "create"/"comment"/"edit" never
  # appear as bare single-word entries in any level's gh_allowed list, only as the
  # second half of a two-word entry, so this can't accidentally admit `gh pr create`.
  if _in_list "$VERB1" "${GH_ALLOWED[@]}" || _in_list "$VERB2" "${GH_ALLOWED[@]}" \
      || _in_list "$TWO_WORD" "${GH_ALLOWED[@]}"; then
    _finish
  fi
  deny "$DISPLAY_VERB"
else
  if _in_list "$VERB1" "${GH_DENIED[@]}" || _in_list "$TWO_WORD" "${GH_DENIED[@]}"; then
    deny "$DISPLAY_VERB"
  fi
  _finish
fi
